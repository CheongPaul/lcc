rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pushPublic/status {
      allow get: if true;
      allow list, write: if false;
    }
    match /pushSubscriptions/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['token', 'language', 'createdAt', 'updatedAt'])
          && d.token is string && d.token.size() > 20 && d.token.size() < 4096
          && d.language in ['ko', 'en']
          && d.updatedAt == request.time;
      }
      allow get, delete: if owner();
      allow list: if false;
      allow create: if owner() && valid() && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid() && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Sender state, other subscriptions and all other collections are private.
    match /{document=**} { allow read, write: if false; }
  }
}
